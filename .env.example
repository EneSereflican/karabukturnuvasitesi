# Supabase yapılandırması
# https://supabase.com/dashboard/project/_/settings/api adresinden alabilirsin

# Public anon key — tarayıcıda görünür, RLS ile korunur
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SADECE server-side, ASLA client'a sızdırma
# RLS'i bypass eder, tam yetkilidir
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT imzalama için güçlü random string (en az 32 karakter)
# Üretmek için: `openssl rand -base64 32` komutunu çalıştır
JWT_SECRET=your-jwt-secret-min-32-chars

# Opsiyonel: Production'da Vercel otomatik ayarlar
# NEXT_PUBLIC_SITE_URL=https://turnuvaburada.com.tr
